    <array>
        <dict>
            <key>CFBundleTypeExtensions</key>
            <array>
                <string>filekitty</string>
            </array>
            <key>CFBundleTypeName</key>
            <string>FileKitty Session</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.bastet.filekitty.session</string>
            </array>
        </dict>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.data</string>
            </array>
            <key>UTTypeDescription</key>
            <string>FileKitty Session</string>
            <key>UTTypeIdentifier</key>
            <string>com.bastet.filekitty.session</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>filekitty</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>NSAppleEventsUsageDescription</key>
    <string>FileKitty needs to access Apple Events for automation features.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>FileKitty uses local network for collaborative session sharing.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_filekitty-sync._tcp</string>
    </array>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>
